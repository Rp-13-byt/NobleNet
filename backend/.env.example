# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/noblenet

# Authentication Secrets (Generate secure random strings in production)
JWT_ACCESS_SECRET=noblenet_super_secret_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=noblenet_super_secret_jwt_refresh_key_change_in_production_2026

# Redis (BullMQ queues & caching)
REDIS_URL=redis://localhost:6379

# File Storage (local | cloudinary)
STORAGE_PROVIDER=local

# Cloudinary (Optional, when STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Razorpay (Optional, when using live payments instead of MockPaymentProvider)
# RAZORPAY_KEY_ID=rzp_test_xxxxxx
# RAZORPAY_KEY_SECRET=xxxxxx
